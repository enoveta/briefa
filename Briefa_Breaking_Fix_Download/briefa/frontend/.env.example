# Briefa API configuration
API_PORT=8787

# Optional AI summaries/classification. Keep all credentials server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional YouTube Data API integration for live/trending videos.
# Leave empty unless you have enabled the YouTube Data API and reviewed quota/terms.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=RW
YOUTUBE_MAX_RESULTS=12

# Optional image generation. Uses OPENAI_API_KEY in the current implementation.
OPENAI_IMAGE_API_URL=https://api.openai.com/v1/images/generations
OPENAI_IMAGE_MODEL=gpt-image-1
